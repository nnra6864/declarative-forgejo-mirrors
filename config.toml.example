# interval = "24h"  # how often every mirror syncs
# rescan = "24h"    # how often owner urls are checked for new repos, --force ignores it
# forks = false     # skip forks everywhere, a mirror's forks = true overrides it
# archived = false  # skip archived repos everywhere, a mirror's archived = true overrides it
# exclude = []      # skip these repo names everywhere, on top of each mirror's own

["git.nnstdios.com"]
mirrors = [
  # "https://github.com/owner/repo",                 # one repo
  # "https://gitlab.com/owner",                      # everything they own
  # { url = "https://codeberg.org/owner", forks = false },  # everything except forks
  # { url = "https://github.com/owner", archived = false },  # everything except archived repos
  # { url = "https://git.example.com/repo", org = "my-mirrors" },  # server without owners
  # { url = "https://cgit.example.com", org = "my-mirrors" },  # every repo on a cgit index
  # { url = "https://github.com/owner/repo", name = "other-name" },  # rename the mirror
  # { url = "https://github.com/owner", interval = "1h" },  # override interval for these
  # { url = "https://github.com/owner", exclude = ["huge-repo", "old-*"] },  # everything except these
]
